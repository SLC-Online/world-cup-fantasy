# Copy to .env and fill in. The CLI auto-loads .env from the project root.

# --- The Odds API (https://the-odds-api.com) ---------------------------------
# Free tier (~500 requests/month) is plenty: a round of WC odds costs a handful
# of credits. Sign up, paste the key here.
ODDS_API_KEY=

# Bookmaker regions to pull (comma-separated): uk, eu, us, us2, au.
# eu/uk tend to have the deepest soccer + player-prop coverage.
ODDS_REGIONS=uk,eu

# Odds format returned by the API. Leave as decimal.
ODDS_FORMAT=decimal

# --- Optional: FIFA player pool auto-fetch -----------------------------------
# The FIFA player list (price/position/nation) is NOT a documented public feed.
# Prices are FIXED for the whole tournament, so you normally capture the pool
# ONCE (see README) into data/players/players.csv and never touch it again.
#
# If you can grab the players JSON request from your browser DevTools (Network
# tab on play.fifa.com/fantasy), paste its URL + a cookie/auth header here and
# `wcf fetch-players` will try it. Leave blank to just use the CSV.
FIFA_PLAYERS_URL=
FIFA_PLAYERS_AUTH_HEADER=

# --- Optional: confirmed line-ups (API-Football / api-sports.io) -------------
# Free key (~100 requests/day). Used by `fetch-lineups` to pull confirmed XIs,
# which publish ~1 hour before each kickoff. Without it, line-ups fall back to
# the FIFA ownership/price prior (or a manual lineups_<round>.csv).
API_FOOTBALL_KEY=

# --- Optional: Telegram notifications (reach your phone anywhere) ------------
# 1) Message @BotFather -> /newbot -> copy the token below.
# 2) Message your bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
